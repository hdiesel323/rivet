# Demo worker is used when no live connector is set.
# Set RIVET_DEMO=1 to keep demo alongside a live worker.
# RIVET_DEMO=0

# Workspace defaults
RIVET_SLOT=rules
RIVET_ROUTE=cascade
RIVET_RESIDENCY=any
RIVET_MAX_USD=0.05
RIVET_DEFAULT_MODEL=auto
RIVET_DB_PATH=db/rivet.sqlite

# Optional: require Authorization: Bearer <key>
# RIVET_API_KEY=

# Live OpenAI-compatible worker (optional)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# RIVET_OPENAI_MODELS=gpt-4o-mini,gpt-4o

# Local OpenAI-compatible runtime (vLLM / Ollama)
# LOCAL_BASE_URL=http://127.0.0.1:8000/v1
# LOCAL_API_KEY=
# RIVET_LOCAL_MODEL=local-llama

# Jev classifier slot (optional)
# JEV_URL=http://127.0.0.1:8787/classify

# CORS (comma-separated)
RIVET_CORS=http://localhost:5173,http://127.0.0.1:5173
